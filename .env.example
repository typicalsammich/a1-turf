# Optional custom public origin; otherwise Vercel's production URL is used.
NEXT_PUBLIC_SITE_URL=
# Connect Redis through Vercel Marketplace (or use KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate independent random secrets; never commit real values.
FORM_SECRET=
ADMIN_PASSWORD=
# Connect a PRIVATE Vercel Blob store to enable photos.
BLOB_READ_WRITE_TOKEN=
